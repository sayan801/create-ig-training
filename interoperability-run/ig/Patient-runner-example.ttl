@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# - resource -------------------------------------------------------------------

<https://example.org/ig/interoperabilityrun/Patient/runner-example> a fhir:Patient ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "runner-example"] ;
  fhir:Resource.meta [
     fhir:Meta.profile [
       fhir:value "https://example.org/ig/interoperabilityrun/StructureDefinition/irun-runner" ;
       fhir:index 0 ;
       fhir:link <https://example.org/ig/interoperabilityrun/StructureDefinition/irun-runner>
     ]
  ] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: Patient runner-example</b></p><a name=\"runner-example\"> </a><a name=\"hcrunner-example\"> </a><div style=\"display: inline-block; background-color: #fbffeb; padding: 6px; margin: 4px; border: 1px solid #8da1b4; border-radius: 5px; line-height: 60%\"><p style=\"margin-bottom: 0px\"/><p style=\"margin-bottom: 0px\">Profile: <a href=\"StructureDefinition-irun-runner.html\">Interoperability Run - runner</a></p></div><p style=\"border: 1px #661aff solid; background-color: #e6e6ff; padding: 10px;\">Alex Runner  Other, DoB: 1985-04-12 ( https://example.org/ig/interoperabilityrun/bib#MLG26-042)</p><hr/></div>"
  ] ;
  fhir:Patient.identifier [
     fhir:index 0 ;
     fhir:Identifier.system [ fhir:value "https://example.org/ig/interoperabilityrun/bib" ] ;
     fhir:Identifier.value [ fhir:value "MLG26-042" ]
  ] ;
  fhir:Patient.name [
     fhir:index 0 ;
     fhir:HumanName.family [ fhir:value "Runner" ] ;
     fhir:HumanName.given [
       fhir:value "Alex" ;
       fhir:index 0
     ]
  ] ;
  fhir:Patient.gender [ fhir:value "other"] ;
  fhir:Patient.birthDate [ fhir:value "1985-04-12"^^xsd:date] .

# - ontology header ------------------------------------------------------------

<https://example.org/ig/interoperabilityrun/Patient/runner-example.ttl> a owl:Ontology ;
